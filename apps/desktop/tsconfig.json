{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": {
      "@pv/replay-engine": ["../../packages/replay-engine/src/index.ts"],
      "@pv/replay-viewer": ["../replay-viewer/src/lib/index.ts"]
    }
  },
  "include": ["src", "test", "electron.vite.config.ts"]
}

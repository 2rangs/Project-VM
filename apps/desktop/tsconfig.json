{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": {
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"],
      "react-dom": ["./node_modules/@types/react-dom/index.d.ts"],
      "pixi.js": ["./node_modules/pixi.js/lib/index.d.ts"],
      "@pv/replay-engine": ["../../packages/replay-engine/src/index.ts"],
      "@pv/replay-viewer": ["../replay-viewer/src/lib/index.ts"],
      "@pv/round-simulator": ["../../packages/round-simulator/src/index.ts"],
      "@pv/spatial-engine": ["../../packages/spatial-engine/src/index.ts"],
      "@pv/combat-engine": ["../../packages/combat-engine/src/index.ts"],
      "@pv/perception-engine": ["../../packages/perception-engine/src/index.ts"],
      "@pv/ability-engine": ["../../packages/ability-engine/src/index.ts"],
      "@pv/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@pv/action-generator": ["../../packages/action-generator/src/index.ts"],
      "@pv/career": ["../../packages/career/src/index.ts"],
      "@pv/decision-debugger": ["../../packages/decision-debugger/src/index.ts"],
      "@pv/decision-engine": ["../../packages/decision-engine/src/index.ts"],
      "@pv/economy-engine": ["../../packages/economy-engine/src/index.ts"],
      "@pv/game-data": ["../../packages/game-data/src/index.ts"],
      "@pv/game-rules": ["../../packages/game-rules/src/index.ts"],
      "@pv/integration-adapters": ["../../packages/integration-adapters/src/index.ts"],
      "@pv/match-runner": ["../../packages/match-runner/src/index.ts"],
      "@pv/outcome-predictor": ["../../packages/outcome-predictor/src/index.ts"],
      "@pv/simulation-core": ["../../packages/simulation-core/src/index.ts"],
      "@pv/team-engine": ["../../packages/team-engine/src/index.ts"],
      "@pv/world-state": ["../../packages/world-state/src/index.ts"]
    }
  },
  "include": ["src", "test", "electron.vite.config.ts"]
}

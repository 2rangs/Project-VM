{
  "name": "@pv/match-runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Match Runner: match-level VALORANT simulation (pistol → halves → 13 wins → OT) with cross-round economy/ultimate carryover, driven by PV-3 TeamDecisionPolicy over PV-4 round-simulator.",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "pv-sim-match": "./src/cli.ts"
  },
  "dependencies": {
    "@pv/shared-types": "workspace:*",
    "@pv/game-rules": "workspace:*",
    "@pv/game-data": "workspace:*",
    "@pv/economy-engine": "workspace:*",
    "@pv/simulation-core": "workspace:*",
    "@pv/world-state": "workspace:*",
    "@pv/decision-engine": "workspace:*",
    "@pv/team-engine": "workspace:*",
    "@pv/integration-adapters": "workspace:*",
    "@pv/round-simulator": "workspace:*",
    "@pv/spatial-engine": "workspace:*",
    "@pv/combat-engine": "workspace:*",
    "@pv/ability-engine": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim:match": "tsx src/cli.ts",
    "sim:series": "tsx src/series-cli.ts"
  }
}

{
  "name": "@pv/decision-debugger",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Decision Debugger: structured trace + human-readable report of generated/excluded actions and why one was selected (Handoff §21).",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "pv-decision-debugger": "./src/cli.ts"
  },
  "dependencies": {
    "@pv/shared-types": "workspace:*",
    "@pv/world-state": "workspace:*",
    "@pv/decision-engine": "workspace:*",
    "@pv/action-generator": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "debug": "tsx src/cli.ts"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "position.schema.json",
  "title": "Position",
  "description": "One player's position+facing at an instant, in game-world Unreal units (uu). FUTURE for real data (Layer-B authorized source only) / POPULATED for synthetic. The legacy minimapUnits frame is removed (v2).",
  "type": "object",
  "required": [
    "playerId",
    "x",
    "y",
    "frame"
  ],
  "additionalProperties": false,
  "properties": {
    "playerId": {
      "type": "string",
      "description": "Player this position belongs to."
    },
    "x": {
      "type": "number",
      "description": "X in game units (uu)."
    },
    "y": {
      "type": "number",
      "description": "Y in game units (uu)."
    },
    "z": {
      "type": "number",
      "description": "Z (elevation) in game units (uu)."
    },
    "frame": {
      "const": "game-world-uu",
      "description": "Coordinate frame tag; always 'game-world-uu'."
    },
    "zoneId": {
      "type": [
        "string",
        "null"
      ],
      "description": "Ascent navgraph zone id, when known."
    },
    "facingDeg": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 360,
      "description": "Facing/view yaw in degrees."
    },
    "alive": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Whether the player was alive at this snapshot."
    }
  }
}

  "description": "Game-world <-> minimap coordinate transform for Icebox, verbatim from valorant-api.com/v1/maps (read 2026-11-19). Same axis-swapped convention as Ascent.",
  "units": {
    "gameUnit": "Unreal unit (uu)",
    "unitsPerMeter": 100
  },
  "transform": {
    "xMultiplier": 7.2e-05,
    "yMultiplier": -7.2e-05,
    "xScalarToAdd": 0.460214,
    "yScalarToAdd": 0.304687,
    "forward": {
      "minimapX": "gameY * xMultiplier + xScalarToAdd",
      "minimapY": "gameX * yMultiplier + yScalarToAdd"
    },
    "inverse": {
      "gameY": "(minimapX - xScalarToAdd) / xMultiplier",
      "gameX": "(minimapY - yScalarToAdd) / yMultiplier"
    }
  },

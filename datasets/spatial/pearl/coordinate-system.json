  "description": "Game-world <-> minimap coordinate transform for Pearl, verbatim from valorant-api.com/v1/maps (read 2026-11-19). Same axis-swapped convention as Ascent.",
  "units": {
    "gameUnit": "Unreal unit (uu)",
    "unitsPerMeter": 100
  },
  "transform": {
    "xMultiplier": 7.8e-05,
    "yMultiplier": -7.8e-05,
    "xScalarToAdd": 0.480469,
    "yScalarToAdd": 0.916016,
    "forward": {
      "minimapX": "gameY * xMultiplier + xScalarToAdd",
      "minimapY": "gameX * yMultiplier + yScalarToAdd"
    },
    "inverse": {
      "gameY": "(minimapX - xScalarToAdd) / xMultiplier",
      "gameX": "(minimapY - yScalarToAdd) / yMultiplier"
    }
  },

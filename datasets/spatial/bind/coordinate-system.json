  "description": "Game-world <-> minimap coordinate transform for Bind, verbatim from valorant-api.com/v1/maps (read 2026-11-19). Same axis-swapped convention as Ascent.",
  "units": {
    "gameUnit": "Unreal unit (uu)",
    "unitsPerMeter": 100
  },
  "transform": {
    "xMultiplier": 5.9e-05,
    "yMultiplier": -5.9e-05,
    "xScalarToAdd": 0.576941,
    "yScalarToAdd": 0.967566,
    "forward": {
      "minimapX": "gameY * xMultiplier + xScalarToAdd",
      "minimapY": "gameX * yMultiplier + yScalarToAdd"
    },
    "inverse": {
      "gameY": "(minimapX - xScalarToAdd) / xMultiplier",
      "gameX": "(minimapY - yScalarToAdd) / yMultiplier"
    }
  },

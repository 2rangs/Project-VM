{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "//": "Root typecheck covers the PV-core packages under their shared strict config. Sibling-branch packages keep their own (looser) tsconfigs and are typechecked via `pnpm -r typecheck` (docs/INTEGRATION_PLAN.md F4).",
  "include": [
    "packages/shared-types/src/**/*.ts",
    "packages/simulation-core/src/**/*.ts",
    "packages/simulation-core/test/**/*.ts",
    "packages/game-rules/src/**/*.ts",
    "packages/game-rules/test/**/*.ts",
    "packages/world-state/src/**/*.ts",
    "packages/world-state/test/**/*.ts",
    "packages/decision-engine/src/**/*.ts",
    "packages/decision-engine/test/**/*.ts",
    "packages/action-generator/src/**/*.ts",
    "packages/action-generator/test/**/*.ts",
    "packages/decision-debugger/src/**/*.ts",
    "packages/decision-debugger/test/**/*.ts",
    "packages/team-engine/src/**/*.ts",
    "packages/team-engine/test/**/*.ts",
    "packages/outcome-predictor/src/**/*.ts",
    "packages/outcome-predictor/test/**/*.ts",
    "packages/integration-adapters/src/**/*.ts",
    "packages/integration-adapters/test/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
